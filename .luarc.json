{
	"$schema": "https://raw.githubusercontent.com/sumneko/vscode-lua/master/setting/schema.json",
	"diagnostics": {
		"groupSeverity": {
			"unused": "Warning",
			"type-check": "Error",
			"unbalanced": "Error",
			"luadoc": "Error",
			"duplicate": "Error",
			"global": "Error"
		},
		"disable": [
			"inject-field",
			"undefined-doc-class",
			"duplicate-doc-field",
			"duplicate-index",
			"duplicate-set-field",
			"duplicate-doc-alias"
		],
		"unusedLocalExclude": ["_*"]
	},
	"runtime": {
		"version": "LuaJIT",
		"enableLuaJITExtensions": true,
		"path": [
			"./packages/*/target/?.lua",
			"./packages/*/target/?/init.lua",
			"./examples/*/target/?.lua",
			"./examples/*/target/?/init.lua"
		],
		"special": { "lazyRequire": "require" }
	},
	"workspace": { "library": ["packages"], "ignoreDir": [".git", "target"] }
}
